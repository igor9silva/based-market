{
	// set prettier as default formatter for json, ts, tsx, js, jsx, html, css
	"[json][jsonc][typescript][typescriptreact][javascript][javascriptreact][html][css][postcss][tailwindcss]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},

	// auto-format on save & paste
	"editor.formatOnSave": true,
	"editor.formatOnPaste": true,

	// ignore node_modules on auto-complete
	"search.exclude": {
		"**/node_modules": true
	},
	"files.exclude": {
		"**/node_modules": true
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	}
}
